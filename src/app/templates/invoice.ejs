<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= locals.subject || "Your OpsCore Invoice" %>
    </title>

    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #0c111d;
            font-family: Inter, Arial, Helvetica, sans-serif;
            color: #ffffff;
            -webkit-font-smoothing: antialiased;
        }

        table {
            border-collapse: collapse;
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        a {
            text-decoration: none;
        }

        .preheader {
            display: none;
            max-height: 0px;
            overflow: hidden;
            opacity: 0;
            font-size: 0px;
            line-height: 0px;
            color: #0c111d;
        }

        .bg-table {
            background-color: #0c111d;
            margin: 0;
            padding: 0;
            width: 100%;
        }

        .wrapper-td {
            padding: 40px 16px;
            text-align: center;
        }

        .main-container {
            max-width: 600px;
            margin: 0 auto;
            width: 100%;
        }

        .text-left {
            text-align: left;
        }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        .pad-b-16 {
            padding-bottom: 16px;
        }

        .pad-b-24 {
            padding-bottom: 24px;
        }

        .pad-b-32 {
            padding-bottom: 32px;
        }

        .brand-glow {
            width: 120px;
            height: 8px;
            border-radius: 999px;
            background-color: #7f56d9;
            background: linear-gradient(90deg, #7f56d9 0%, #6941c6 100%);
            box-shadow: 0 0 18px rgba(127, 86, 217, 0.45);
            display: inline-block;
        }

        .brand-badge {
            display: inline-block;
            padding: 12px 18px;
            border-radius: 14px;
            background-color: rgba(127, 86, 217, 0.12);
            border: 1px solid rgba(127, 86, 217, 0.25);
            color: #ffffff;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 0.3px;
        }

        .brand-highlight {
            color: #7f56d9;
        }

        .card {
            background-color: #1d2939;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 40px 32px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
        }

        .heading {
            margin: 0;
            font-size: 28px;
            line-height: 1.3;
            font-weight: 700;
            color: #ffffff;
        }

        .subheading {
            margin: 8px 0 0 0;
            font-size: 16px;
            line-height: 1.6;
            color: #94a3b8;
        }

        .amount-due {
            margin: 0;
            font-size: 42px;
            line-height: 1.2;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -1px;
        }

        .label-text {
            margin: 0 0 4px 0;
            font-size: 13px;
            line-height: 1.5;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #667085;
        }

        .value-text {
            margin: 0;
            font-size: 15px;
            line-height: 1.6;
            color: #ffffff;
            font-weight: 500;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .status-paid {
            background-color: rgba(18, 183, 106, 0.15);
            color: #12b76a;
            border: 1px solid rgba(18, 183, 106, 0.3);
        }

        .status-pending {
            background-color: rgba(245, 158, 11, 0.15);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .status-canceled {
            background-color: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        .invoice-table {
            width: 100%;
            margin-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .invoice-th {
            padding: 16px 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .invoice-td {
            padding: 16px 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 15px;
            color: #ffffff;
            line-height: 1.6;
        }

        .invoice-td-sub {
            font-size: 13px;
            color: #94a3b8;
            margin-top: 4px;
        }

        .summary-row td {
            padding: 12px 8px;
            font-size: 15px;
            color: #94a3b8;
        }

        .summary-total td {
            padding: 16px 8px 0 8px;
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
        }

        .cta-button {
            display: inline-block;
            padding: 14px 28px;
            border-radius: 12px;
            background: linear-gradient(135deg, #7f56d9 0%, #6941c6 100%);
            color: #ffffff !important;
            font-size: 16px;
            font-weight: 600;
            box-shadow: 0 8px 20px rgba(127, 86, 217, 0.3);
            text-align: center;
        }

        .divider {
            height: 1px;
            background-color: rgba(255, 255, 255, 0.08);
            width: 100%;
            line-height: 1px;
            font-size: 1px;
            margin: 32px 0;
        }

        .footer-text {
            margin: 0 0 10px 0;
            font-size: 14px;
            line-height: 1.6;
            color: #667085;
        }

        .support-link {
            color: #7f56d9;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <div class="preheader">
        Invoice <%= locals.invoiceNumber || "" %> for <%= locals.currency || "$" %>
                <%= locals.totalAmount || "0.00" %> is <%= locals.status ? locals.status.toLowerCase() : "ready" %>.
    </div>

    <table role="presentation" border="0" class="bg-table">
        <tr>
            <td class="wrapper-td">
                <table role="presentation" border="0" class="main-container">
                    <tr>
                        <td class="text-center pad-b-24">
                            <div class="brand-glow"></div>
                        </td>
                    </tr>

                    <tr>
                        <td class="card text-left">
                            <table role="presentation" border="0" width="100%">
                                <tr>
                                    <td valign="top" class="pad-b-32">
                                        <div class="brand-badge">
                                            <span class="brand-highlight">Ops</span>Core
                                        </div>
                                    </td>
                                    <td valign="top" class="text-right pad-b-32">
                                        <h1 class="heading">Invoice</h1>
                                        <p class="subheading">#<%= locals.invoiceNumber || "INV-0000" %>
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" border="0" width="100%">
                                <tr>
                                    <td class="pad-b-32">
                                        <p class="label-text">Amount Due</p>
                                        <p class="amount-due">
                                            <%= locals.currency || "$" %>
                                                <%= locals.totalAmount || "0.00" %>
                                        </p>
                                    </td>
                                    <td class="text-right pad-b-32" valign="bottom">
                                        <div class="status-badge
                                          <%= locals.status && locals.status.toLowerCase() === 'paid'
                                            ? 'status-paid'
                                            : locals.status && locals.status.toLowerCase() === 'canceled'
                                            ? 'status-canceled'
                                            : 'status-pending' %>">
                                            <%= locals.status || "Pending" %>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" border="0" width="100%" class="pad-b-16">
                                <tr>
                                    <td width="50%" valign="top" class="pad-b-16">
                                        <p class="label-text">Billed To</p>
                                        <p class="value-text">
                                            <%= locals.customerName || "Customer" %>
                                        </p>
                                        <% if (locals.customerEmail) { %>
                                            <p class="value-text" style="color: #94a3b8; font-size: 14px;">
                                                <%= locals.customerEmail %>
                                            </p>
                                            <% } %>
                                    </td>
                                    <td width="25%" valign="top" class="pad-b-16">
                                        <p class="label-text">Issue Date</p>
                                        <p class="value-text">
                                            <%= locals.issueDate || "N/A" %>
                                        </p>
                                    </td>
                                    <td width="25%" valign="top" class="text-right pad-b-16">
                                        <p class="label-text">Due Date</p>
                                        <p class="value-text">
                                            <%= locals.dueDate || "N/A" %>
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" border="0" class="invoice-table">
                                <tr>
                                    <th class="invoice-th text-left">Description</th>
                                    <th class="invoice-th text-right" width="20%">Qty</th>
                                    <th class="invoice-th text-right" width="25%">Amount</th>
                                </tr>

                                <% if (locals.items && locals.items.length> 0) { %>
                                    <% locals.items.forEach(function(item) { %>
                                        <tr>
                                            <td class="invoice-td text-left">
                                                <%= item.description || "Service/Product" %>
                                                    <% if (item.subtext) { %>
                                                        <div class="invoice-td-sub">
                                                            <%= item.subtext %>
                                                        </div>
                                                        <% } %>
                                            </td>
                                            <td class="invoice-td text-right">
                                                <%= item.quantity || 1 %>
                                            </td>
                                            <td class="invoice-td text-right">
                                                <%= locals.currency || "$" %>
                                                    <%= item.amount || "0.00" %>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td class="invoice-td text-left" colspan="3"
                                                        style="text-align: center; color: #667085;">
                                                        No line items provided.
                                                    </td>
                                                </tr>
                                                <% } %>

                                                    <tr class="summary-row">
                                                        <td colspan="2" class="text-right" style="padding-top: 16px;">
                                                            Subtotal</td>
                                                        <td class="text-right" style="padding-top: 16px;">
                                                            <%= locals.currency || "$" %>
                                                                <%= locals.subtotal || locals.totalAmount || "0.00" %>
                                                        </td>
                                                    </tr>

                                                    <% if (locals.tax) { %>
                                                        <tr class="summary-row">
                                                            <td colspan="2" class="text-right">Tax</td>
                                                            <td class="text-right">
                                                                <%= locals.currency || "$" %>
                                                                    <%= locals.tax %>
                                                            </td>
                                                        </tr>
                                                        <% } %>

                                                            <tr class="summary-total">
                                                                <td colspan="2" class="text-right">Total</td>
                                                                <td class="text-right">
                                                                    <%= locals.currency || "$" %>
                                                                        <%= locals.totalAmount || "0.00" %>
                                                                </td>
                                                            </tr>
                            </table>

                            <div class="divider"></div>

                            <% if (locals.actionUrl) { %>
                                <table role="presentation" border="0" width="100%">
                                    <tr>
                                        <td class="text-center">
                                            <a href="<%= locals.actionUrl %>" class="cta-button">
                                                <%= locals.actionText || "Pay Invoice Now" %>
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                                <% } %>
                        </td>
                    </tr>

                    <tr>
                        <td class="text-center pad-b-24" style="padding-top: 24px;">
                            <p class="footer-text">
                                If you have any questions about this invoice, please reach out to us.
                            </p>
                            <% if (locals.supportEmail) { %>
                                <p class="footer-text" style="margin-bottom: 24px;">
                                    Need help?
                                    <a href="mailto:<%= locals.supportEmail %>" class="support-link">
                                        <%= locals.supportEmail %>
                                    </a>
                                </p>
                                <% } %>
                                    <p class="footer-text" style="font-size: 12px;">
                                        © <%= locals.year || new Date().getFullYear() %>
                                            <%= locals.appName || "OpsCore" %>. All rights reserved.
                                    </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
