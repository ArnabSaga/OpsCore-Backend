model Workspace {
  id               String   @id @default(uuid(7))
  name             String
  slug             String   @unique
  stripeCustomerId String?  @unique
  createdByUserId  String
  createdByUser    User     @relation("WorkspaceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  trialStartsAt          DateTime?
  trialEndsAt            DateTime?
  planOverride           SubscriptionPlan?
  planOverrideExpiresAt  DateTime?
  billingCycleStartsAt   DateTime?
  billingCycleEndsAt     DateTime?

  sessions        Session[]
  members         WorkspaceMember[]
  invitations     WorkspaceInvitation[]
  projects        Project[]
  projectMembers  ProjectMember[]
  invoices        Invoice[]
  invoiceItems    InvoiceItem[]
  subscriptions   Subscription[]
  activityLogs    ActivityLog[]   @relation("ActivityWorkspace")
  tasks           Task[]
  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]

  @@index([createdByUserId])
  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id            String                @id @default(uuid(7))
  workspaceId   String
  userId        String
  role          WorkspaceMemberRole   @default(MEMBER)
  status        WorkspaceMemberStatus @default(ACTIVE)
  joinedAt      DateTime              @default(now())
  addedByUserId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedByUser User?     @relation("WorkspaceMemberAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([addedByUserId])
  @@index([workspaceId, role])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String              @id @default(uuid(7))
  workspaceId String
  email       String
  role        WorkspaceMemberRole @default(MEMBER)
  status      InvitationStatus    @default(PENDING)
  invitedById String
  token       String              @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  canceledAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([status])
  @@index([token])
  @@index([expiresAt])
  @@map("workspace_invitations")
}
